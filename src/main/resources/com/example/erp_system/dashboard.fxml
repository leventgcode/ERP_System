<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.erp_system.DashboardController">

    <left>
        <VBox prefWidth="200.0" spacing="10.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>
            <Label text="ERP MENU" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="20.0" left="10.0" />
                </VBox.margin>
            </Label>

            <Button onAction="#onHomeButtonClick" maxWidth="1.7976931348623157E308" prefHeight="40.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;" text="Ana Sayfa" />
            <Button onAction="#onCustomersButtonClick" maxWidth="1.7976931348623157E308" prefHeight="40.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;" text="Müşteriler" />
            <Button onAction="#onProductsButtonClick" maxWidth="1.7976931348623157E308" prefHeight="40.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;" text="Stok Yönetimi" />
            <Button onAction="#onInvoicesButtonClick" maxWidth="1.7976931348623157E308" prefHeight="40.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;" text="Faturalar" />
            <Button fx:id="logoutButton" onAction="#onLogoutButtonClick" maxWidth="1.7976931348623157E308" prefHeight="40.0" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-cursor: hand;" text="Çıkış Yap">
                <VBox.margin>
                    <Insets top="50.0" />
                </VBox.margin>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>